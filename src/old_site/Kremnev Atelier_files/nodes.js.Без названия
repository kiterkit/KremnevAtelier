                value = value.toString();

                // А дальше к нужному типу
                if (typing === 'number') {
                    value = value * 1 || 0;
                } else if (typing === 'boolean') {
                    value = value === '1' || value === 'true';
                }

                $field.find('[cr-field]').attr('data-value', value);

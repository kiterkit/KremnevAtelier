                // Добавляем пустышки, чтобы картинки загрузились в исходном размере
                const src = decodeURIComponent(key);
                mini_size_loader.cache[src] = { width: 0, height: 0 };
            }

            for (const waiter of waiters) {
                waiter.reject();
            }

            console.error(error);
        });
    }
}


                });

                if (nonpopovers.length === 0) {
                    $(creatium.scroll.snapping ? '.area-wrapper' : 'body').css('overflow', '');
                }
            }

            clearTimeout(timeout);
            modal.$el.off('force-hide', delayed);
        };

